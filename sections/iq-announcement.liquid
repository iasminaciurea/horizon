{%- liquid
  assign messages = section.blocks | where: 'type', 'message'
-%}
{%- if messages.size > 0 -%}
  <div
    class="iq-announcement"
    style="--iq-mq-duration: {{ section.settings.duration }}s; background: {{ section.settings.background }}; color: {{ section.settings.text }};"
    role="region"
    aria-label="{{ 'iq.header.announcements' | t }}"
  >
    <div class="iq-marquee{% if section.settings.pause_on_hover %} iq-marquee--pausable{% endif %}">
      {%- for copy in (1..2) -%}
        <ul class="iq-marquee__group"{% if forloop.index == 2 %} aria-hidden="true"{% endif %}>
          {%- for block in messages -%}
            <li class="iq-marquee__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}"{% if forloop.parentloop.index == 2 %} tabindex="-1"{% endif %}>{{ block.settings.text }}</a>
              {%- else -%}
                <span>{{ block.settings.text }}</span>
              {%- endif -%}
              <span class="iq-marquee__dot" aria-hidden="true">·</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "IQ — Announcement marquee",
  "class": "iq-announcement-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "range",
      "id": "duration",
      "label": "Time for one full loop",
      "min": 10,
      "max": 90,
      "step": 2,
      "unit": "s",
      "default": 40
    },
    { "type": "checkbox", "id": "pause_on_hover", "label": "Pause on hover", "default": true },
    { "type": "color", "id": "background", "label": "Background", "default": "#1A1A1A" },
    { "type": "color", "id": "text", "label": "Text", "default": "#FFFFFF" },
    {
      "type": "paragraph",
      "content": "The marquee stops moving for visitors who have reduced motion turned on."
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "IQ — Announcement marquee" }]
}
{% endschema %}
