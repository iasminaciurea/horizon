{%- liquid
  assign s = section.settings
  assign c = s.collection
  assign first_row = s.first_row
  assign total = s.products_count
  assign cover_title = s.cover_title | default: c.title
-%}
<section class="iq-band">
  <div class="iq-band__inner">
    <div class="iq-wrap">
      <div class="iq-band__head">
        <div class="iq-band__titles">
          {%- if s.eyebrow != blank -%}<span class="iq-eyebrow iq-eyebrow--dark">{{ s.eyebrow }}</span>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="iq-band__title">{{ s.heading }}</h2>{%- endif -%}
        </div>
        {%- if s.text != blank -%}
          <div class="iq-band__text">{{ s.text }}</div>
        {%- endif -%}
      </div>

      <div class="iq-band__rail" style="--iq-band-cover-span: {{ 5 | minus: first_row | at_least: 1 }};">
        <a href="{{ c.url | default: '#' }}" class="iq-band__cover">
          <span class="iq-band__cover-media">
            {%- if s.cover_image != blank -%}
              {%- assign cover_alt = s.cover_image.alt | default: cover_title | escape -%}
              {{ s.cover_image | image_url: width: 1200 | image_tag: widths: '400, 600, 900, 1200', sizes: '(min-width: 1280px) 40vw, (min-width: 768px) 45vw, 212px', loading: 'lazy', alt: cover_alt }}
            {%- else -%}
              {%- render 'iq-collection-image', collection: c, sizes: '(min-width: 1280px) 40vw, (min-width: 768px) 45vw, 212px', width: 1200 -%}
            {%- endif -%}
          </span>
          <span class="iq-band__cover-shade" aria-hidden="true"></span>
          <span class="iq-band__cover-copy">
            <span class="iq-band__cover-title">{{ cover_title }}</span>
            {%- if s.cover_link_label != blank -%}<span class="iq-band__cover-link">{{ s.cover_link_label }}</span>{%- endif -%}
          </span>
        </a>
        {%- if c != blank -%}
          {%- for p in c.products limit: total -%}
            <div class="iq-band__item{% if forloop.index <= first_row %} iq-band__item--first{% endif %}">
              {%- render 'iq-product-card',
                product: p,
                tone: 'dark',
                sizes: '(min-width: 1280px) 20vw, (min-width: 768px) 33vw, 182px'
              -%}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "IQ — Dark collection band",
  "class": "iq-section iq-section--band",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Supplies the cover tile and the products." },
    { "type": "image_picker", "id": "cover_image", "label": "Cover image override", "info": "Defaults to the collection's image. Portrait 900×1200." },
    { "type": "text", "id": "cover_title", "label": "Cover title override" },
    { "type": "text", "id": "cover_link_label", "label": "Cover link label" },
    { "type": "range", "id": "products_count", "label": "Products", "min": 3, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "first_row", "label": "Products next to the cover (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 }
  ],
  "presets": [{ "name": "IQ — Dark collection band" }]
}
{% endschema %}
