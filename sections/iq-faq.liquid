{%- assign s = section.settings -%}
<section class="iq-faq">
  <div class="iq-wrap iq-wrap--narrow">
    {%- render 'iq-section-head', eyebrow: s.eyebrow, title: s.heading, align: 'center' -%}
    <div class="iq-accordion">
      {%- for block in section.blocks -%}
        <details class="iq-accordion__item" {% if forloop.first and s.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary class="iq-accordion__summary">
            <span>{{ block.settings.question }}</span>
            <span class="iq-accordion__icon" aria-hidden="true">
              <span class="iq-accordion__plus">{%- render 'iq-icon', name: 'plus', stroke: 1.4 -%}</span>
              <span class="iq-accordion__minus">{%- render 'iq-icon', name: 'minus', stroke: 1.4 -%}</span>
            </span>
          </summary>
          <div class="iq-accordion__content iq-rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- if s.schema_markup and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "IQ — FAQ",
  "class": "iq-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": true },
    { "type": "checkbox", "id": "schema_markup", "label": "Add FAQ structured data", "default": true }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [{ "name": "IQ — FAQ", "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }] }]
}
{% endschema %}
