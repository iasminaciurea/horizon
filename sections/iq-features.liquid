<section class="iq-features">
  <div class="iq-wrap">
    <ul class="iq-features__grid" role="list" style="--iq-cols: {{ section.blocks.size | at_least: 1 | at_most: 4 }};">
      {%- for block in section.blocks -%}
        <li class="iq-features__item" {{ block.shopify_attributes }}>
          {%- if block.settings.custom_icon != blank -%}
            {{ block.settings.custom_icon | image_url: width: 80 | image_tag: width: 30, height: 30, loading: 'lazy', alt: '' }}
          {%- else -%}
            {%- render 'iq-icon', name: block.settings.icon, size: 30, stroke: 1.3 -%}
          {%- endif -%}
          {%- if block.settings.title != blank -%}<span class="iq-features__title">{{ block.settings.title }}</span>{%- endif -%}
          {%- if block.settings.text != blank -%}<span class="iq-features__text">{{ block.settings.text }}</span>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "IQ — Icons with text",
  "class": "iq-section iq-section--features",
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Delivery" },
            { "value": "return", "label": "Returns" },
            { "value": "card", "label": "Payment" },
            { "value": "award", "label": "Experience" },
            { "value": "pin", "label": "Location" },
            { "value": "phone", "label": "Phone" },
            { "value": "mail", "label": "Email" },
            { "value": "heart", "label": "Heart" },
            { "value": "check", "label": "Check" }
          ],
          "default": "truck"
        },
        { "type": "image_picker", "id": "custom_icon", "label": "Custom icon", "info": "Replaces the icon above." },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "IQ — Icons with text", "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }, { "type": "feature" }] }]
}
{% endschema %}
