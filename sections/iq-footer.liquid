{%- liquid
  assign s = section.settings
  assign columns = section.blocks | where: 'type', 'menu'
-%}
<div class="iq-footer">
  <div class="iq-wrap iq-footer__inner">
    {%- if s.show_newsletter -%}
      <div class="iq-footer__newsletter">
        <div class="iq-footer__newsletter-copy">
          {%- if s.newsletter_heading != blank -%}
            <h2 class="iq-footer__newsletter-title">{{ s.newsletter_heading }}</h2>
          {%- endif -%}
          {%- if s.newsletter_text != blank -%}
            <p class="iq-footer__newsletter-text">{{ s.newsletter_text }}</p>
          {%- endif -%}
        </div>
        <div class="iq-footer__newsletter-form">
          {%- form 'customer', id: 'IqNewsletter', class: 'iq-newsletter' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p class="iq-newsletter__msg" role="status">{{ 'iq.footer.newsletter_success' | t }}</p>
            {%- else -%}
              <div class="iq-newsletter__row">
                <label for="IqNewsletterEmail" class="iq-visually-hidden">{{ 'iq.footer.email_label' | t }}</label>
                <input
                  id="IqNewsletterEmail"
                  type="email"
                  name="contact[email]"
                  required
                  autocomplete="email"
                  placeholder="{{ 'iq.footer.email_placeholder' | t }}"
                  {% if form.errors %}aria-invalid="true" aria-describedby="IqNewsletterError"{% endif %}
                >
                <button type="submit" class="iq-btn iq-btn--light">{{ 'iq.footer.subscribe' | t }}</button>
              </div>
              {%- if form.errors -%}
                <p class="iq-newsletter__msg iq-newsletter__msg--error" id="IqNewsletterError" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
              {%- endif -%}
            {%- endif -%}
          {%- endform -%}
          {%- if s.newsletter_disclaimer != blank -%}
            <div class="iq-footer__disclaimer">{{ s.newsletter_disclaimer }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="iq-footer__main">
      <div class="iq-footer__brand">
        <span class="iq-footer__brand-name">{{ s.brand_name | default: shop.name }}</span>
        {%- if s.brand_text != blank -%}
          <div class="iq-footer__brand-text">{{ s.brand_text }}</div>
        {%- endif -%}
        {%- render 'iq-social-links', class: 'iq-footer__social' -%}
      </div>
      {%- for block in columns -%}
        <div class="iq-footer__col" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <span class="iq-footer__col-title">{{ block.settings.heading }}</span>
          {%- endif -%}
          {%- if block.settings.menu != blank -%}
            <ul role="list">
              {%- for link in block.settings.menu.links -%}
                <li>
                  <a
                    href="{{ link.url }}"
                    {% if link.type == 'http_link' %}
                      {%- assign host = link.url | split: '/' | slice: 2 | first -%}
                      {%- if host != request.host -%}target="_blank" rel="nofollow noopener"{%- endif -%}
                    {% endif %}
                  >{{ link.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="iq-footer__bottom">
      <div class="iq-footer__legal-text">
        <span>
          © {{ 'now' | date: '%Y' }} {{ s.brand_name | default: shop.name }}. {{ s.copyright_text }}
        </span>
        {%- capture trader -%}
          {%- if s.company_name != blank -%}{{ s.company_name }}{%- endif -%}
          {%- if s.company_cui != blank -%} · {{ 'iq.footer.cui' | t }} {{ s.company_cui }}{%- endif -%}
          {%- if s.company_reg != blank -%} · {{ 'iq.footer.reg' | t }} {{ s.company_reg }}{%- endif -%}
          {%- if s.company_address != blank -%} · {{ s.company_address }}{%- endif -%}
        {%- endcapture -%}
        {%- if trader != blank -%}
          <span class="iq-footer__trader">{{ trader }}</span>
        {%- endif -%}
      </div>
      <div class="iq-footer__badges">
        <a href="https://anpc.ro/ce-este-sal/" target="_blank" rel="nofollow noopener" class="iq-footer__badge">
          {%- if s.sal_image != blank -%}
            {{ s.sal_image | image_url: width: 500 | image_tag: width: 250, height: 52, loading: 'lazy', alt: 'ANPC SAL' }}
          {%- else -%}
            <span class="iq-footer__badge-text">{{ 'iq.footer.sal' | t }}</span>
          {%- endif -%}
        </a>
        <a href="https://ec.europa.eu/consumers/odr" target="_blank" rel="nofollow noopener" class="iq-footer__badge">
          {%- if s.sol_image != blank -%}
            {{ s.sol_image | image_url: width: 500 | image_tag: width: 250, height: 52, loading: 'lazy', alt: 'SOL' }}
          {%- else -%}
            <span class="iq-footer__badge-text">{{ 'iq.footer.sol' | t }}</span>
          {%- endif -%}
        </a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "IQ — Footer",
  "class": "iq-footer-section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Heading" },
    { "type": "text", "id": "newsletter_text", "label": "Text" },
    { "type": "richtext", "id": "newsletter_disclaimer", "label": "Consent note", "info": "Link to your privacy policy here." },
    {
      "type": "paragraph",
      "content": "Subscribers are saved as customers with the tag \"newsletter\". Send the welcome discount with Shopify Email or Shopify Flow."
    },
    { "type": "header", "content": "Brand" },
    { "type": "text", "id": "brand_name", "label": "Brand name", "info": "Defaults to the store name." },
    { "type": "richtext", "id": "brand_text", "label": "Description" },
    { "type": "paragraph", "content": "Social links are set in Theme settings → IQ Fashion — Store and social." },
    { "type": "header", "content": "Bottom row" },
    { "type": "text", "id": "copyright_text", "label": "Text after copyright" },
    { "type": "header", "content": "Trader identification (legal)" },
    { "type": "text", "id": "company_name", "label": "Company name", "default": "ELVE STYLE SRL" },
    { "type": "text", "id": "company_cui", "label": "CUI" },
    { "type": "text", "id": "company_reg", "label": "Trade register number (J…)" },
    { "type": "text", "id": "company_address", "label": "Registered address" },
    { "type": "header", "content": "ANPC badges (legal requirement)" },
    {
      "type": "paragraph",
      "content": "The badges always link to anpc.ro/ce-este-sal and ec.europa.eu/consumers/odr. Upload the official images (250×52)."
    },
    { "type": "image_picker", "id": "sal_image", "label": "ANPC SAL badge" },
    { "type": "image_picker", "id": "sol_image", "label": "SOL badge" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "presets": [{ "name": "IQ — Footer" }]
}
{% endschema %}
