{%- liquid
  assign s = section.settings
  assign spots = section.blocks | where: 'type', 'spot'
-%}
<section class="iq-hotspots">
  <div class="iq-wrap">
    {%- render 'iq-section-head', eyebrow: s.eyebrow, title: s.heading -%}
    <iq-hotspots class="iq-hotspots__layout">
      <div class="iq-hotspots__image">
        {%- if s.image != blank -%}
          {%- assign hs_alt = s.image.alt | escape -%}
          {{ s.image | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1800', sizes: '(min-width: 1280px) 60vw, 100vw', loading: 'lazy', alt: hs_alt }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'iq-placeholder-svg' }}
        {%- endif -%}
        {%- for block in spots -%}
          {%- assign p = block.settings.product -%}
          <button
            type="button"
            class="iq-hotspot{% if forloop.first %} is-active{% endif %}"
            style="top: {{ block.settings.y }}%; left: {{ block.settings.x }}%;"
            data-iq-spot="{{ forloop.index }}"
            aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="spot-card-{{ block.id }}"
            aria-label="{{ 'iq.hotspots.show' | t: title: p.title }}"
            {{ block.shopify_attributes }}
          >
            {{- forloop.index -}}
          </button>
        {%- endfor -%}
      </div>
      <div class="iq-hotspots__list">
        {%- for block in spots -%}
          {%- assign p = block.settings.product -%}
          <article class="iq-spot-card{% if forloop.first %} is-active{% endif %}" id="spot-card-{{ block.id }}" data-iq-spot-card="{{ forloop.index }}">
            <a href="{{ p.url | default: '#' }}" class="iq-spot-card__media" tabindex="-1" aria-hidden="true">
              {%- if p.featured_image -%}
                {{ p.featured_image | image_url: width: 240 | image_tag: widths: '120, 184, 240', sizes: '92px', loading: 'lazy', alt: '' }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'iq-placeholder-svg' }}
              {%- endif -%}
            </a>
            <div class="iq-spot-card__info">
              {%- if block.settings.tag != blank -%}<span class="iq-spot-card__tag">{{ block.settings.tag }}</span>{%- endif -%}
              <a href="{{ p.url | default: '#' }}" class="iq-spot-card__name">{{ p.title | default: block.settings.tag }}</a>
              {%- if p != blank -%}
                {%- render 'iq-price', price: p.price, compare_at: p.compare_at_price, size: 'md' -%}
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
        {%- if s.cta_label != blank -%}
          <a href="{{ s.cta_link | default: routes.all_products_collection_url }}" class="iq-btn iq-btn--outline iq-btn--block">{{ s.cta_label }}</a>
        {%- endif -%}
      </div>
    </iq-hotspots>
  </div>
</section>

{% schema %}
{
  "name": "IQ — Shop the look",
  "class": "iq-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Landscape 1800×1350." },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "spot",
      "name": "Hotspot",
      "limit": 6,
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "tag", "label": "Label", "info": "E.g. Rochia, Pe deasupra, Accesoriu" },
        { "type": "range", "id": "x", "label": "Horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "y", "label": "Vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 }
      ]
    }
  ],
  "presets": [{ "name": "IQ — Shop the look", "blocks": [{ "type": "spot" }, { "type": "spot" }, { "type": "spot" }] }]
}
{% endschema %}
