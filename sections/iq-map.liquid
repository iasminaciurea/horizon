{%- comment -%}
  Map + showroom. The Google Maps embed sets third-party cookies, so it only loads after the
  visitor clicks "Load map"; until then a static image (or placeholder) is shown.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign maps = s.maps_link | default: settings.iq_store_maps_url
  assign query = s.map_address | strip_html | url_encode
-%}
<section class="iq-map">
  <div class="iq-wrap">
    <div class="iq-map__layout">
      <iq-map-embed class="iq-map__frame" data-src="https://www.google.com/maps?q={{ query }}&output=embed" data-title="{{ s.map_address | strip_html | escape }}">
        {%- if s.image != blank -%}
          {%- assign map_alt = s.image.alt | default: s.map_address | strip_html | escape -%}
          {{ s.image | image_url: width: 1400 | image_tag: widths: '600, 900, 1400', sizes: '(min-width: 1024px) 60vw, 100vw', loading: 'lazy', alt: map_alt, class: 'iq-map__img' }}
        {%- endif -%}
        {%- if s.map_address != blank -%}
          <div class="iq-map__consent">
            <p>{{ 'iq.map.notice' | t }}</p>
            <button type="button" class="iq-btn iq-btn--outline iq-btn--sm" data-iq-map-load>{{ 'iq.map.load' | t }}</button>
          </div>
        {%- endif -%}
      </iq-map-embed>
      <div class="iq-map__copy">
        {%- if s.eyebrow != blank -%}<span class="iq-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="iq-h2">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="iq-rte">{{ s.text }}</div>{%- endif -%}
        {%- if s.button_label != blank and maps != blank -%}
          <a href="{{ maps }}" target="_blank" rel="noopener" class="iq-btn iq-btn--primary iq-btn--icon">
            {%- render 'iq-icon', name: 'pin', size: 16, stroke: 1.6 -%}{{ s.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "IQ — Map and showroom",
  "class": "iq-section",
  "settings": [
    { "type": "text", "id": "map_address", "label": "Address for the map", "info": "E.g. Bulevardul Eroilor 14, Cluj-Napoca" },
    { "type": "image_picker", "id": "image", "label": "Static map image", "info": "Shown until the visitor loads the interactive map." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "maps_link", "label": "Maps link", "info": "Defaults to Theme settings → Google Maps link." }
  ],
  "presets": [{ "name": "IQ — Map and showroom" }]
}
{% endschema %}
