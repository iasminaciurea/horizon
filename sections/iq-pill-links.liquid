{%- comment -%}
  "În tendințe" quick links under the hero. Links come from the Link blocks; if a menu is
  selected it is used instead, so the list can also be managed in Content → Menus.
{%- endcomment -%}
{%- liquid
  assign menu = section.settings.menu
  assign use_menu = false
  if menu != blank and menu.links.size > 0
    assign use_menu = true
  endif
  assign pill_blocks = section.blocks | where: 'type', 'link'
-%}
{%- if use_menu or pill_blocks.size > 0 -%}
  <section class="iq-pills-section">
    <div class="iq-wrap iq-pills">
      {%- if section.settings.label != blank -%}
        <span class="iq-pills__label">{{ section.settings.label }}</span>
      {%- endif -%}
      <ul class="iq-pills__list" role="list">
        {%- if use_menu -%}
          {%- for link in menu.links -%}
            <li><a href="{{ link.url }}" class="iq-pills__link">{{ link.title }}</a></li>
          {%- endfor -%}
        {%- else -%}
          {%- for block in pill_blocks -%}
            {%- liquid
              assign c = block.settings.collection
              assign url = block.settings.link | default: c.url
              assign title = block.settings.title | default: c.title
            -%}
            {%- if title != blank -%}
              <li {{ block.shopify_attributes }}>
                <a href="{{ url | default: routes.all_products_collection_url }}" class="iq-pills__link">{{ title }}</a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "IQ — Quick links",
  "class": "iq-section iq-section--flush",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "info": "Hidden on mobile." },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu (optional)",
      "info": "If selected, the menu's links replace the Link blocks below."
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Supplies the title and link unless overridden below." },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "url", "id": "link", "label": "Link override" }
      ]
    }
  ],
  "presets": [{ "name": "IQ — Quick links", "blocks": [{ "type": "link" }, { "type": "link" }, { "type": "link" }] }]
}
{% endschema %}
