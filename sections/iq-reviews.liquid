{%- comment -%}
  Reviews wrapper styled to the design. The reviews themselves come from Judge.me (add its
  app block here). The headline rating reads Judge.me's shop metafields when they exist.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign rating = shop.metafields.judgeme.all_reviews_rating.value | default: shop.metafields.judgeme.all_reviews_rating
  assign count = shop.metafields.judgeme.all_reviews_count.value | default: shop.metafields.judgeme.all_reviews_count
  if template.name == 'product'
    if product.metafields.reviews.rating.value
      assign rating = product.metafields.reviews.rating.value.rating
      assign count = product.metafields.reviews.rating_count.value
    endif
  endif
  assign rating_num = rating | plus: 0
  assign rating_label = rating_num | round: 1 | append: '' | replace: '.', ','
-%}
<section class="iq-reviews" id="{{ s.anchor | default: 'recenzii' | handleize }}">
  <div class="iq-wrap">
    <div class="iq-section-head">
      <div class="iq-section-head__copy">
        {%- if s.eyebrow != blank -%}<span class="iq-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        <h2 class="iq-h2">
          {%- if rating_num > 0 -%}
            {{ 'iq.reviews.heading' | t: rating: rating_label, count: count }}
          {%- else -%}
            {{ s.heading }}
          {%- endif -%}
        </h2>
        {%- if rating_num > 0 -%}
          <div class="iq-reviews__meta">
            {%- render 'iq-stars', rating: rating_num, size: 18 -%}
            {%- if s.badge != blank -%}<span class="iq-reviews__badge">{{ s.badge }}</span>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
      {%- if s.link_label != blank and s.link != blank -%}
        <a href="{{ s.link }}" class="iq-link-cta">{{ s.link_label }}</a>
      {%- endif -%}
    </div>
    <div class="iq-reviews__apps">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "IQ — Reviews",
  "class": "iq-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Used when no rating is available yet." },
    { "type": "text", "id": "badge", "label": "Verification badge text" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "recenzii" },
    { "type": "paragraph", "content": "Add the Judge.me widget as an app block. Its cards are styled to match the theme." }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "IQ — Reviews" }]
}
{% endschema %}
