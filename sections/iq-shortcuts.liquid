<section class="iq-shortcuts">
  <div class="iq-wrap">
    <ul class="iq-shortcuts__grid" role="list" style="--iq-cols: {{ section.blocks.size | at_least: 1 | at_most: 4 }};">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: '#' }}" class="iq-shortcut">
            <span class="iq-shortcut__title">{{ block.settings.title }}</span>
            {%- if block.settings.text != blank -%}<span class="iq-shortcut__text">{{ block.settings.text }}</span>{%- endif -%}
            {%- render 'iq-icon', name: 'chevron-right', size: 16, stroke: 1.6, class: 'iq-shortcut__arrow' -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "IQ — Shortcut cards",
  "class": "iq-section",
  "settings": [],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "IQ — Shortcut cards", "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }] }]
}
{% endschema %}
