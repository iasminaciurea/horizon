{%- liquid
  assign s = section.settings
  assign v = s.video
  assign small = null
  assign big = null
  for src in v.sources
    if src.format == 'mp4'
      if big == null or src.width > big.width
        assign big = src
      endif
      if src.width <= 720
        if small == null or src.width > small.width
          assign small = src
        endif
      endif
    endif
  endfor
  if small == null
    assign small = big
  endif
-%}
<section class="iq-showroom">
  <div class="iq-wrap">
    <div class="iq-showroom__box">
      <div class="iq-showroom__media">
        {%- if small != null -%}
          <button
            type="button"
            class="iq-showroom__video"
            data-iq-lightbox-src="{{ big.url }}"
            data-iq-lightbox-caption="{{ s.video_caption | escape }}"
            aria-label="{{ 'iq.video.open' | t: title: s.heading }}"
          >
            <video autoplay muted loop playsinline preload="metadata" aria-hidden="true" tabindex="-1" data-iq-ambient {% if s.poster != blank %}poster="{{ s.poster | image_url: width: 840 }}"{% endif %}>
              <source src="{{ small.url }}" type="{{ small.mime_type }}">
            </video>
            <span class="iq-reel__play" aria-hidden="true">{%- render 'iq-icon', name: 'play', size: 18 -%}</span>
          </button>
        {%- elsif s.poster != blank -%}
          {%- assign poster_alt = s.poster.alt | escape -%}
          {{ s.poster | image_url: width: 840 | image_tag: widths: '420, 840', sizes: '(min-width: 768px) 420px, 100vw', loading: 'lazy', alt: poster_alt }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'iq-placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="iq-showroom__copy">
        {%- if s.eyebrow != blank -%}<span class="iq-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="iq-h2">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="iq-showroom__text">{{ s.text }}</div>{%- endif -%}
        <ul class="iq-showroom__facts" role="list">
          {%- if s.address != blank -%}
            <li>{%- render 'iq-icon', name: 'pin', stroke: 1.4 -%}<div>{{ s.address }}</div></li>
          {%- endif -%}
          {%- if s.hours != blank -%}
            <li>{%- render 'iq-icon', name: 'clock', stroke: 1.4 -%}<div>{{ s.hours }}</div></li>
          {%- endif -%}
          {%- if s.show_email and settings.iq_store_email != blank -%}
            <li>{%- render 'iq-icon', name: 'mail', stroke: 1.4 -%}<a href="mailto:{{ settings.iq_store_email }}">{{ settings.iq_store_email }}</a></li>
          {%- endif -%}
        </ul>
        <div class="iq-showroom__actions">
          {%- assign maps = s.maps_link | default: settings.iq_store_maps_url -%}
          {%- if s.maps_label != blank and maps != blank -%}
            <a href="{{ maps }}" class="iq-btn iq-btn--primary iq-btn--icon" target="_blank" rel="noopener">
              {%- render 'iq-icon', name: 'pin', size: 16, stroke: 1.6 -%}
              {{ s.maps_label }}
            </a>
          {%- endif -%}
          {%- if s.contact_label != blank and s.contact_link != blank -%}
            <a href="{{ s.contact_link }}" class="iq-btn iq-btn--outline">{{ s.contact_label }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "IQ — Showroom",
  "class": "iq-section",
  "settings": [
    { "type": "video", "id": "video", "label": "Vertical video", "info": "9:16, plays muted in a loop. Click opens it with sound." },
    { "type": "image_picker", "id": "poster", "label": "Poster / image" },
    { "type": "text", "id": "video_caption", "label": "Video caption" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "richtext", "id": "address", "label": "Address" },
    { "type": "richtext", "id": "hours", "label": "Opening hours" },
    { "type": "checkbox", "id": "show_email", "label": "Show contact email", "default": true },
    { "type": "text", "id": "maps_label", "label": "Maps button label" },
    { "type": "url", "id": "maps_link", "label": "Maps link", "info": "Defaults to Theme settings → Google Maps link." },
    { "type": "text", "id": "contact_label", "label": "Contact button label" },
    { "type": "url", "id": "contact_link", "label": "Contact link" }
  ],
  "presets": [{ "name": "IQ — Showroom" }]
}
{% endschema %}
