{%- comment -%}
  One wishlist card, rendered in product context: /products/{handle}?section_id=iq-wishlist-card
{%- endcomment -%}
{%- liquid
  capture flags
    render 'iq-product-flags', product: product
  endcapture
  assign percent = 0
  if flags contains 'sale'
    assign percent = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
  endif
  capture size_pos
    render 'iq-option-position', product: product, kind: 'size'
  endcapture
  assign size_pos = size_pos | strip
-%}
<li class="iq-wishlist-item" data-iq-wishlist-item="{{ product.handle }}" data-first-variant="{{ product.selected_or_first_available_variant.id }}" data-single="{{ product.has_only_default_variant }}" data-available="{{ product.available }}">
  <script type="application/json" data-iq-wishlist-variants>
    { {%- for v in product.variants -%}
      {%- capture v_title -%}{%- for o in v.options -%}{%- render 'iq-term', text: o -%}{%- unless forloop.last %} · {% endunless -%}{%- endfor -%}{%- endcapture -%}
      "{{ v.id }}": {"title": {{ v_title | json }}, "available": {{ v.available }}}{% unless forloop.last %},{% endunless %}
    {%- endfor -%} }
  </script>
  <article class="iq-card iq-card--wishlist">
    <div class="iq-card__media">
      <a href="{{ product.url }}" class="iq-card__image-link" tabindex="-1" aria-hidden="true">
        {%- if product.featured_media -%}
          {{ product.featured_media.preview_image | image_url: width: 800 | image_tag: widths: '300, 450, 600, 800', sizes: '(min-width: 1280px) 25vw, (min-width: 768px) 33vw, 50vw', loading: 'lazy', class: 'iq-card__img iq-card__img--main', alt: '' }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'iq-card__img iq-placeholder-svg' }}
        {%- endif -%}
      </a>
      <div class="iq-card__badges iq-card__badges--start">
        {%- if flags contains 'sale' -%}<span class="iq-badge iq-badge--sale">−{{ percent }}%</span>{%- endif -%}
      </div>
      <button type="button" class="iq-card__remove" data-iq-wishlist-remove="{{ product.handle }}" aria-label="{{ 'iq.wishlist.remove_item' | t: title: product.title }}">
        {%- render 'iq-icon', name: 'close', size: 16, stroke: 1.6 -%}
      </button>
      {%- if flags contains 'soldout' -%}
        <div class="iq-card__badges iq-card__badges--end"><span class="iq-badge iq-badge--soldout">{{ 'iq.badges.sold_out' | t }}</span></div>
      {%- endif -%}
    </div>
    <div class="iq-card__content">
      <a href="{{ product.url }}" class="iq-card__title">{{ product.title }}</a>
      {%- render 'iq-price', price: product.price, compare_at: product.compare_at_price, from: product.price_varies, size: 'md' -%}
      <span class="iq-card__variant" data-iq-wishlist-variant></span>
      {%- if size_pos != '' -%}
        {%- assign option_key = 'option' | append: size_pos -%}
        {%- assign size_index = size_pos | minus: 1 -%}
        <div class="iq-card__sizes iq-card__sizes--static" aria-label="{{ 'iq.product.sizes_label' | t }}">
          {%- for value in product.options_with_values[size_index].values -%}
            {%- liquid
              assign ok = false
              for v in product.variants
                if v[option_key] == value.name and v.available
                  assign ok = true
                  break
                endif
              endfor
            -%}
            <span class="iq-pill{% unless ok %} is-off{% endunless %}">{%- render 'iq-term', text: value.name -%}<span class="iq-visually-hidden">{% unless ok %} — {{ 'iq.product.sold_out_short' | t }}{% endunless %}</span></span>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if product.available -%}
        <button type="button" class="iq-btn iq-btn--primary iq-btn--block iq-btn--sm" data-iq-wishlist-buy data-url="{{ product.url }}">{{ 'iq.product.add_to_cart' | t }}</button>
      {%- else -%}
        <a href="#" class="iq-btn iq-btn--outline iq-btn--block iq-btn--sm" data-iq-wishlist-notify>{{ 'iq.wishlist.notify' | t }}</a>
      {%- endif -%}
    </div>
  </article>
</li>

{% schema %}
{
  "name": "IQ — Wishlist card",
  "settings": []
}
{% endschema %}
