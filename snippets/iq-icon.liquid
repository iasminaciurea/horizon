{%- doc -%}
  Inline line icons used by the IQ Fashion sections.

  @param {string} name - search | account | heart | bag | plus | minus | close | chevron-right | chevron-left | chevron-down | menu | pin | clock | mail | phone | truck | return | card | award | star | check | zoom | share | facebook | instagram | tiktok | youtube | play | trend
  @param {number} [size] - Pixel size, default 20
  @param {number} [stroke] - Stroke width, default 1.5
  @param {string} [class] - Extra class
{%- enddoc -%}
{%- liquid
  assign s = size | default: 20
  assign sw = stroke | default: 1.5
-%}
{%- capture paths -%}
  {%- case name -%}
    {%- when 'search' -%}<circle cx="11" cy="11" r="7"/><path d="M16.5 16.5 21 21"/>
    {%- when 'account' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>
    {%- when 'heart' -%}<path d="M12 20s-7-4.5-7-9.5A3.5 3.5 0 0 1 12 7a3.5 3.5 0 0 1 7 3.5c0 5-7 9.5-7 9.5z"/>
    {%- when 'bag' -%}<path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'close' -%}<path d="M5 5l14 14M19 5 5 19"/>
    {%- when 'chevron-right' -%}<path d="m9 5 7 7-7 7"/>
    {%- when 'chevron-left' -%}<path d="m15 5-7 7 7 7"/>
    {%- when 'chevron-down' -%}<path d="m5 9 7 7 7-7"/>
    {%- when 'menu' -%}<path d="M3 7h18M3 12h18M3 17h18"/>
    {%- when 'pin' -%}<path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>
    {%- when 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>
    {%- when 'mail' -%}<rect x="3" y="5" width="18" height="14"/><path d="m3 7 9 6 9-6"/>
    {%- when 'phone' -%}<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>
    {%- when 'truck' -%}<path d="m3 8 9-4 9 4-9 4-9-4z"/><path d="M3 8v8l9 4 9-4V8"/>
    {%- when 'return' -%}<path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/>
    {%- when 'card' -%}<rect x="2" y="6" width="20" height="13"/><path d="M2 10h20"/>
    {%- when 'award' -%}<circle cx="12" cy="9" r="5"/><path d="m8 14-2 7 6-3 6 3-2-7"/>
    {%- when 'check' -%}<path d="M20 6 9 17l-5-5"/>
    {%- when 'zoom' -%}<circle cx="11" cy="11" r="7"/><path d="M16.5 16.5 21 21M11 8v6M8 11h6"/>
    {%- when 'share' -%}<circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="m8.2 10.8 7.6-4.6M8.2 13.2l7.6 4.6"/>
    {%- when 'facebook' -%}<path d="M14 9h3V5h-3a4 4 0 0 0-4 4v2H8v4h2v6h4v-6h3l1-4h-4V9z"/>
    {%- when 'instagram' -%}<rect x="3" y="3" width="18" height="18"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="1"/>
    {%- when 'tiktok' -%}<path d="M15 4v8.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M15 4c0 2.2 1.8 4 4 4"/>
    {%- when 'youtube' -%}<rect x="2.5" y="5.5" width="19" height="13" rx="3"/><path d="m10 9 5 3-5 3V9z"/>
    {%- when 'play' -%}<path d="M8 5v14l11-7L8 5z"/>
    {%- when 'trend' -%}<path d="m3 17 6-6 4 4 8-8"/><path d="M15 7h6v6"/>
  {%- endcase -%}
{%- endcapture -%}
{%- if name == 'star' -%}
  <svg class="iq-icon iq-icon--star {{ class }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10 1l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9 4.8 17.2l1-5.8L1.5 7.2l5.9-.9z"/></svg>
{%- else -%}
  <svg class="iq-icon iq-icon--{{ name }} {{ class }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ sw }}" aria-hidden="true" focusable="false">{{ paths }}</svg>
{%- endif -%}
